{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/workopia/Australia-Casual-Part-Time-Jobs/blob/main/.github/schema/listings.schema.json",
  "title": "Workopia Australia casual jobs repository dataset",
  "type": "object",
  "required": ["meta", "categories", "listings"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "repo",
        "title",
        "country_iso",
        "country_name",
        "adjective",
        "segment",
        "as_of",
        "generated_at",
        "window_days"
      ],
      "properties": {
        "repo": { "const": "Australia-Casual-Part-Time-Jobs" },
        "title": { "type": "string", "minLength": 1 },
        "country_iso": { "const": "AU" },
        "country_name": { "const": "Australia" },
        "adjective": { "const": "Australian" },
        "segment": { "const": "au" },
        "site_slug": { "type": "string", "minLength": 1 },
        "lang": { "type": "string", "minLength": 2 },
        "as_of": { "type": "string", "format": "date" },
        "generated_at": { "type": "string", "format": "date-time" },
        "window_days": { "type": "integer", "minimum": 1 },
        "total_site_jobs_str": { "type": "string", "minLength": 1 },
        "tagging_source": { "type": "string" },
        "pool_source": { "type": "string" },
        "seasonal_live_roles": { "type": "integer", "minimum": 0 },
        "hydrated_rows": { "type": "integer", "minimum": 0 }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "name", "icon"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "icon": { "type": "string", "minLength": 1 },
          "l4slug": { "type": ["string", "null"] }
        }
      }
    },
    "seasonal": {
      "type": "array",
      "items": { "$ref": "#/$defs/listing" }
    },
    "listings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/listing" }
    }
  },
  "$defs": {
    "listing": {
      "type": "object",
      "required": [
        "id",
        "company_name",
        "title",
        "location",
        "date_posted",
        "active",
        "url",
        "category",
        "tier"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "company_name": { "type": "string", "minLength": 1 },
        "company_hi_slug": { "type": ["string", "null"] },
        "title": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "pay_display": { "type": ["string", "null"] },
        "shift": { "type": ["string", "null"] },
        "ticket": { "type": ["string", "null"] },
        "no_experience": { "type": "boolean" },
        "xmas": { "type": "boolean" },
        "seasonal": { "type": ["string", "null"] },
        "hot": { "type": "boolean" },
        "date_posted": { "type": ["string", "null"], "format": "date-time" },
        "active": { "type": "boolean" },
        "url": {
          "type": "string",
          "pattern": "^https://workopia\\.io/jobs/[A-Za-z0-9-]+$"
        },
        "category": { "type": "string", "minLength": 1 },
        "tier": { "enum": ["Casual", "Part-time", "Temp & Seasonal"] },
        "employment_type_norm": { "type": ["string", "null"] },
        "employment_type_raw": { "type": ["string", "null"] },
        "locations_count": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
